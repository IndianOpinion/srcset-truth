<?xml version="1.0"?>
<ruleset name="srcset-truth">
    <description>PSR-12 for the plugin and its tests.</description>
    <file>src</file>
    <file>tests</file>
    <file>examples</file>
    <file>srcset-truth.php</file>
    <file>uninstall.php</file>
    <exclude-pattern>tests/stubs/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12">
        <!-- WordPress entry points declare and run in one file by design. -->
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
    </rule>
    <!-- PSR-12 soft limit is 120. Raised to 160 so translatable strings and HTML fixtures stay whole on one line for translators and grep; code is wrapped. -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="160"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
    <!-- WP-CLI maps subcommands to public methods; test names carry PRD test numbers. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
